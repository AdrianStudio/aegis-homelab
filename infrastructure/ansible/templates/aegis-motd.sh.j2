#!/bin/bash
# AEGIS login banner for {{ inventory_hostname }}.
# Managed by Ansible (motd.yml + templates/aegis-motd.sh.j2): manual edits get overwritten.
# Runs at every login via pam_motd, so the K3s and uptime lines are live.

B=$'\e[{{ motd_color }}m' # box border
Y=$'\e[1;33m'             # title
G=$'\e[1;32m'             # healthy
R=$'\e[1;31m'             # not healthy
N=$'\e[0m'                # reset
W={{ motd_width }}        # inner width of the box

# row LABEL TEXT [COLOUR]: TEXT must be plain ASCII, or the padding won't line up.
row() {
  printf '%s║%s%s%-*s%s%s║%s\n' "$B" "$N" "${3:-}" "$W" "$(printf ' %-6s : %s' "$1" "$2")" "$N" "$B" "$N"
}

if [ -x /usr/local/bin/k3s ]; then
  k3s_ver=$(/usr/local/bin/k3s --version 2>/dev/null | awk 'NR==1 {print $3}')
  if systemctl is-active --quiet k3s; then
    k3s_text="$k3s_ver (activo)"; k3s_colour=$G
  else
    k3s_text="$k3s_ver ($(systemctl is-active k3s))"; k3s_colour=$R
  fi
else
  k3s_text="no instalado"; k3s_colour=$R
fi

echo
printf '%s╔%s╗%s\n' "$B" "{{ '═' * motd_width }}" "$N"
printf '%s║%s%s%s%s%s║%s\n' "$B" "$N" "$Y" "{{ motd_title | center(motd_width) }}" "$N" "$B" "$N"
printf '%s╠%s╣%s\n' "$B" "{{ '═' * motd_width }}" "$N"
row "Host"   "{{ inventory_hostname }} ({{ ansible_host }})"
row "Rol"    "{{ motd_role }}"
row "VM"     "{{ vm_id }} en {{ proxmox_node }}"
row "K3s"    "$k3s_text" "$k3s_colour"
row "Uptime" "$(uptime -p | sed 's/^up //')"
# Replaces Ubuntu's "System restart required" message, which is disabled with the rest.
[ -f /var/run/reboot-required ] && row "Aviso" "reinicio pendiente (os-prep.yml)" "$R"
printf '%s╚%s╝%s\n' "$B" "{{ '═' * motd_width }}" "$N"
echo
